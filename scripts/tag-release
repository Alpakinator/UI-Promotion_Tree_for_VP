#!/usr/bin/env bash
# Tag HEAD as release v<version> (the .modinfo's version), with NOTES as the
# message, kept verbatim: git's default cleanup drops "### Heading" lines as
# comments. The message becomes the GitHub release notes.
# Before: bump version= in the .modinfo and its file name (git mv), commit.
# Usage: scripts/tag-release NOTES.md    then: git push origin HEAD v<version>
set -euo pipefail
notes=${1:?usage: scripts/tag-release NOTES.md}
[ -s "$notes" ] || { echo "$notes is empty or missing; it becomes the release notes." >&2; exit 1; }
notes=$(realpath "$notes")
cd "$(git rev-parse --show-toplevel)"
if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
  echo "Uncommitted changes: commit them first, the tag goes on HEAD." >&2
  exit 1
fi
tag=v$(python3 scripts/checks.py version --rev HEAD)
if git rev-parse -q --verify "refs/tags/$tag" >/dev/null; then
  echo "$tag already exists. Bump version= in the .modinfo and its file name (git mv) first." >&2
  exit 1
fi
git tag -a --cleanup=verbatim -F "$notes" "$tag"
if ! python3 scripts/checks.py tag "$tag"; then
  git tag -d "$tag" >/dev/null
  echo "Removed $tag again; fix the problems above and rerun." >&2
  exit 1
fi
echo "Tagged $tag. Publish: git push origin HEAD $tag"
